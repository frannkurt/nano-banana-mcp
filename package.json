{
  "name": "nano-banana-mcp",
  "version": "0.1.0",
  "description": "MCP server for generating images with Google Flow (Nano Banana) at exact pixel sizes and aspect ratios, downloaded straight to disk.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "nano-banana-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.62.0",
    "sharp": "^0.34.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nano-banana",
    "google-flow",
    "image-generation",
    "text-to-image",
    "ai-images",
    "claude",
    "claude-code",
    "design"
  ]
}

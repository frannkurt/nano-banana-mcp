{
  "name": "nano-banana-mcp",
  "version": "0.1.0",
  "description": "Free MCP server for AI image generation - no API key, no billing. Uses Nano Banana via Google Flow with your own Google account, at exact pixel sizes, with reference images. $0 per image.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "nano-banana-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright-core": "^1.62.0",
    "sharp": "^0.34.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "free",
    "free-image-generation",
    "no-api-key",
    "zero-cost",
    "nano-banana",
    "google-flow",
    "gemini-image",
    "image-generation",
    "text-to-image",
    "ai-images",
    "image-to-image",
    "reference-image",
    "claude",
    "claude-code",
    "claude-desktop",
    "anthropic",
    "design",
    "automation",
    "playwright"
  ],
  "homepage": "https://github.com/frannkurt/nano-banana-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frannkurt/nano-banana-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/frannkurt/nano-banana-mcp/issues"
  },
  "author": "Franco Escudero (@frannkurt)"
}

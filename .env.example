# Endpoint CDP del Chrome que vos ya abriste y logueaste.
FLOW_CDP_URL=http://127.0.0.1:9222

# Donde se guardan las imagenes generadas.
FLOW_OUTPUT_DIR=./output

# Costo maximo en puntos que se permite gastar. 0 = solo generaciones gratis.
# Las imagenes cuestan 0; el video cuesta. Subilo solo si sabes lo que haces.
FLOW_MAX_COST=0
